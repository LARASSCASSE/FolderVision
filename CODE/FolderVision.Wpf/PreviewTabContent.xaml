<UserControl x:Class="FolderVision.Wpf.PreviewTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderVision.Wpf.Models"
             xmlns:conv="clr-namespace:FolderVision.Wpf.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolConverter x:Key="InverseBool"/>

            <!-- Node label -->
            <Style x:Key="PreviewNodeLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                        <Setter Property="Foreground" Value="#FF505050"/>
                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Node inline editor -->
            <Style x:Key="PreviewNodeEditor" TargetType="TextBox">
                <Setter Property="Background" Value="#FF2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="BorderBrush" Value="#FF4C7FDB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="MinWidth" Value="160"/>
            </Style>

            <!-- TreeViewItem: bind IsExpanded to PreviewNode.IsExpanded -->
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            </Style>

            <!-- HierarchicalDataTemplate -->
            <HierarchicalDataTemplate DataType="{x:Type local:PreviewNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <!-- Unchecked = included (empty box) | Checked = excluded (shows ×) -->
                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                              Style="{StaticResource DarkCheckBox}"
                              Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DisplayName}"
                               Style="{StaticResource PreviewNodeLabel}"
                               MouseLeftButtonDown="NodeLabel_MouseLeftButtonDown"/>
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PreviewNodeEditor}"
                             LostFocus="NodeEditor_LostFocus"
                             KeyDown="NodeEditor_KeyDown"/>

                    <!-- Bulk-uncheck button: only when >5 children, only on hover -->
                    <Button Content="✕ tout décocher"
                            Margin="8,0,0,0"
                            Padding="7,2"
                            FontSize="10"
                            Cursor="Hand"
                            Focusable="False"
                            Click="UncheckChildren_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Background" Value="#FF3A3A3D"/>
                                <Setter Property="Foreground" Value="#FFB0B0B0"/>
                                <Setter Property="BorderBrush" Value="#FF555558"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF4A4A4E"/>
                                                    <Setter Property="Foreground" Value="#FFEEEEEE"/>
                                                    <Setter Property="BorderBrush" Value="#FF777779"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="Background" Value="#FF2A2A2D"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                            <Condition Binding="{Binding ShowUncheckButton}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header options bar -->
        <Border Grid.Row="0"
                Background="#FF2D2D30"
                BorderBrush="#FF4A4A4D"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="IncludeHeaderCheckBox"
                          Style="{StaticResource DarkCheckBox}"
                          IsChecked="False"
                          Margin="0,0,8,0"/>
                <TextBlock Text="Header PDF"
                           FontSize="12"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#FFB0B0B0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=IncludeHeaderCheckBox}" Value="True">
                                    <Setter Property="Foreground" Value="#FF505050"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Preview tree -->
        <TreeView x:Name="PreviewTree"
                  Grid.Row="1"
                  Background="#FF252526"
                  BorderThickness="0"
                  Margin="4"/>
    </Grid>
</UserControl>

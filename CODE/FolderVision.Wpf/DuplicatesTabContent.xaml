<UserControl x:Class="FolderVision.Wpf.DuplicatesTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderVision.Wpf.Models"
             xmlns:conv="clr-namespace:FolderVision.Wpf.Converters">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:InverseBoolConverter x:Key="InverseBool"/>

            <!-- Group node (root level) label — red-purple tint -->
            <Style x:Key="DupGroupLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFC07070"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                        <Setter Property="Foreground" Value="#FF505050"/>
                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Path node (leaf level) label -->
            <Style x:Key="DupPathLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFB0B0B0"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                        <Setter Property="Foreground" Value="#FF505050"/>
                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- TreeViewItem -->
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            </Style>

            <!-- HierarchicalDataTemplate — group nodes have red label, path nodes gray -->
            <HierarchicalDataTemplate DataType="{x:Type local:PreviewNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, Converter={StaticResource InverseBool}}"
                              Style="{StaticResource DarkCheckBox}"
                              Margin="0,0,6,0"/>
                    <!-- Group node (depth 0) uses red label; path node (depth > 0) uses gray -->
                    <TextBlock Text="{Binding DisplayName}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DupPathLabel}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                        <Setter Property="Foreground" Value="#FFC07070"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="12"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                        <Setter Property="Foreground" Value="#FF505050"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Bulk-uncheck button (same as PreviewTabContent) -->
                    <Button Content="✕ tout décocher"
                            Margin="8,0,0,0"
                            Padding="7,2"
                            FontSize="10"
                            Cursor="Hand"
                            Focusable="False"
                            Click="UncheckChildren_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Background" Value="#FF3A3A3D"/>
                                <Setter Property="Foreground" Value="#FFB0B0B0"/>
                                <Setter Property="BorderBrush" Value="#FF555558"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FF4A4A4E"/>
                                                    <Setter Property="Foreground" Value="#FFEEEEEE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                            <Condition Binding="{Binding ShowUncheckButton}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0"
                Background="#FF2D2D30"
                BorderBrush="#FF4A4A4D"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="GroupCountLabel"
                           Text="0 duplicate groups"
                           FontSize="12"
                           FontFamily="Segoe UI"
                           Foreground="#FFC07070"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                <TextBlock Text="— uncheck to exclude from export"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           Foreground="#FF707070"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Duplicates tree -->
        <TreeView x:Name="DuplicatesTree"
                  Grid.Row="1"
                  Background="#FF252526"
                  BorderThickness="0"
                  Margin="4"/>
    </Grid>
</UserControl>

<Window x:Class="FolderVision.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FolderVision"
        Icon="Ressources/app.ico"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="52"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ TOP TOOLBAR (custom chrome) ═══════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <!-- App title — left side (draggable area via WindowChrome CaptionHeight) -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,120,0">
                    <Image Source="Ressources/foldervision_icon-removebg.png"
                           Height="38"
                           Width="38"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="FolderVision"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  |  Multi-threaded folder scanner"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window control buttons — right side -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <!-- Minimize -->
                    <!-- Minimize -->
                    <Button Content="&#xE921;"
                            Width="46" Height="52"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
/>
                    <!-- Maximize/Restore — rounded square drawn in XAML -->
                    <Button x:Name="MaximizeButton"
                            Width="46" Height="52"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
>
                        <Rectangle Width="10" Height="10"
                                   RadiusX="1" RadiusY="1"
                                   Fill="Transparent"
                                   StrokeThickness="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <!-- Close -->
                    <Button Content="&#xE8BB;"
                            Width="46" Height="52"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left panel -->
                <ColumnDefinition Width="280" MinWidth="220"/>
                <!-- Splitter -->
                <ColumnDefinition Width="4"/>
                <!-- Center panel -->
                <ColumnDefinition Width="320" MinWidth="260"/>
                <!-- Splitter -->
                <ColumnDefinition Width="4"/>
                <!-- Right panel (tree) -->
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ──────────── LEFT PANEL ──────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- SCAN PATHS — plus grande que les autres -->
                        <RowDefinition Height="1.6*"/>
                        <!-- SCAN SETTINGS -->
                        <RowDefinition Height="*"/>
                        <!-- EXPORT SETTINGS -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── SCAN PATHS ── -->
                    <Grid Grid.Row="0" Margin="12,14,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="SCAN PATHS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8"/>

                        <!-- Added paths list -->
                        <ListBox x:Name="PathsListBox"
                                 Grid.Row="1"
                                 Margin="0,0,0,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 ScrollViewer.PanningMode="Both"
                                 PreviewMouseWheel="PathsListBox_PreviewMouseWheel"
                                 MouseEnter="PathsListBox_MouseEnter"
                                 MouseLeave="PathsListBox_MouseLeave">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="×"
                                                Width="20"
                                                FontSize="12"
                                                Click="RemovePathItem_Click"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                Focusable="False"
                                                VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="Foreground" Value="#FF909090"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Foreground" Value="#FFEEEEEE"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Add path + Clear all buttons -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="AddPathButton"
                                    Grid.Column="0"
                                    Content="+ Add Path"
                                    Height="32"
                                    Style="{StaticResource DefaultButton}"
                                    Click="AddPathButton_Click"/>
                            <Button x:Name="ClearAllPathsButton"
                                    Grid.Column="2"
                                    Height="32"
                                    Width="36"
                                    Style="{StaticResource DefaultButton}"
                                    Click="ClearAllPathsButton_Click">
                                <!-- Trash can icon drawn as Path -->
                                <Path Data="M4,0 H8 V2 H12 V4 H0 V2 H4 Z M1,5 L2,14 H10 L11,5 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="14"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- ── SCAN SETTINGS ── -->
                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Margin="12,14,12,12" VerticalAlignment="Top">
                            <TextBlock Text="SCAN SETTINGS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Max Threads"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="ThreadCountLabel" Grid.Column="1" Text="8"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="ThreadsSlider"
                                    Minimum="1" Maximum="32" Value="8"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,12"
                                    ValueChanged="ThreadsSlider_ValueChanged"
/>
                            <CheckBox x:Name="SkipHiddenCheckBox"
                                      Content="Skip Hidden Folders" IsChecked="True"
                                      Margin="0,0,0,8"
                                      Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
/>
                            <CheckBox x:Name="SkipSystemCheckBox"
                                      Content="Skip System Folders" IsChecked="True"
                                      Margin="0,0,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
/>
                        </StackPanel>
                    </Border>

                    <!-- ── EXPORT SETTINGS ── -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel Margin="12,14,12,12" VerticalAlignment="Top">
                            <TextBlock Text="EXPORT SETTINGS"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Report Depth"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock x:Name="ReportDepthLabel" Grid.Column="1" Text="0"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="ReportDepthSlider"
                                    Minimum="0" Maximum="10" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,4"
                                    ValueChanged="ReportDepthSlider_ValueChanged"
/>
                            <TextBlock Text="0 = show all levels"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,12"/>
                            <CheckBox x:Name="PreviewBeforeExportCheckBox"
                                      Content="Preview before export" FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,8"/>
                            <CheckBox x:Name="OpenAfterExportCheckBox"
                                      Content="Open PDF after export" FontSize="12"
                                      IsChecked="True"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!-- ──────────── CENTER PANEL ──────────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource BackgroundDarkBrush}">
                <!-- DockPanel: stats+export anchored to bottom, scan controls centered in remaining space. -->
                <DockPanel LastChildFill="True">

                    <!-- Bottom zone: Stats block + Export buttons, anchored to bottom -->
                    <StackPanel DockPanel.Dock="Bottom"
                                HorizontalAlignment="Stretch"
                                Margin="20,0,20,16">

                        <!-- Stats block -->
                        <Border x:Name="StatsBlock"
                                Background="{StaticResource BackgroundMediumBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="SCAN RESULTS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="📁 Folders:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,4"/>
                                    <TextBlock x:Name="TotalFoldersLabel" Grid.Row="0" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="📄 Files:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,4"/>
                                    <TextBlock x:Name="TotalFilesLabel" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="⏱ Duration:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="DurationLabel" Grid.Row="2" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Export button -->
                        <Button x:Name="ExportPdfButton"
                                Content="📑 Export PDF"
                                Style="{StaticResource DefaultButton}"
                                Click="ExportPdfButton_Click"
                                IsEnabled="False"
                                Height="34"
                                Width="240"
                                HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Scan controls: fills the remaining space and centers its content -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="20">

                            <Button x:Name="StartScanButton"
                                    Content="▶  Start Scan"
                                    Style="{StaticResource BigScanButton}"
                                    Click="StartScanButton_Click"
                                    Margin="0,0,0,16"
                                    IsEnabled="False"
/>

                            <Grid Margin="0,0,0,24" Height="34" Width="260">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CancelScanButton"
                                        Grid.Column="0"
                                        Content="■  Cancel"
                                        Style="{StaticResource DefaultButton}"
                                        Click="CancelScanButton_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="PauseScanButton"
                                        Grid.Column="2"
                                        Content="II"
                                        Style="{StaticResource DefaultButton}"
                                        Click="PauseScanButton_Click"
                                        IsEnabled="False"
                                        FontWeight="Bold"
                                        FontSize="11"/>
                            </Grid>

                            <StackPanel x:Name="ProgressSection"
                                        Visibility="Collapsed">
                                <ProgressBar x:Name="ScanProgressBar"
                                             Value="0"
                                             Maximum="100"
                                             Height="10"
                                             Width="260"
                                             Margin="0,0,0,8"/>

                                <TextBlock x:Name="ProgressLabel"
                                           Text=""
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="11"
                                           TextAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="260"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!-- ──────────── RIGHT PANEL (TabControl) ──────────── -->
            <Border Grid.Column="4"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <TabControl x:Name="RightTabControl"
                            Loaded="RightTabControl_Loaded">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Single-row tab strip with scroll arrows -->
                                <Border Grid.Row="0"
                                        Background="{StaticResource BackgroundLightBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Left arrow — far left, hidden when at start -->
                                        <Button x:Name="TabScrollLeftBtn"
                                                Grid.Column="0"
                                                Content="‹"
                                                Style="{StaticResource TabNavButton}"
                                                Click="TabScrollLeft_Click"
                                                Visibility="Collapsed"/>
                                        <!-- Scrollable tab strip — takes all remaining space -->
                                        <ScrollViewer x:Name="TabHeaderScroll"
                                                      Grid.Column="1"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      Focusable="False">
                                            <TabPanel IsItemsHost="True" Background="Transparent"/>
                                        </ScrollViewer>
                                        <!-- Right arrow — far right, hidden when at end -->
                                        <Button x:Name="TabScrollRightBtn"
                                                Grid.Column="2"
                                                Content="›"
                                                Style="{StaticResource TabNavButton}"
                                                Click="TabScrollRight_Click"
                                                Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Grid.Row="1"
                                                  ContentSource="SelectedContent"/>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <!-- ── Fixed "Folder Structure" tab (no close button) ── -->
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="Folder Structure"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                        </TabItem.Header>

                        <Grid>
                            <!-- Placeholder when no scan -->
                            <TextBlock x:Name="TreePlaceholder"
                                       Text="Run a scan to view the folder structure here."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="240"
                                       Margin="16"/>

                            <!-- Actual TreeView -->
                            <TreeView x:Name="FolderTreeView"
                                      Margin="4"
                                      Visibility="Collapsed"
                                      BorderThickness="0"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"/>

                            <!-- Spinner visible entre fin de scan et affichage de l'arbre -->
                            <Grid x:Name="TreeLoadingSpinner"
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <!-- Track (dim) -->
                                <Ellipse Width="48" Height="48"
                                         Stroke="#33FFFFFF" StrokeThickness="4" Fill="Transparent"/>
                                <!-- Arc rotatif -->
                                <Ellipse Width="48" Height="48" Fill="Transparent"
                                         Stroke="#FF4C7FDB" StrokeThickness="4"
                                         StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                         StrokeDashArray="10 20"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform x:Name="SpinnerRotateTransform" Angle="0"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetName="SpinnerRotateTransform"
                                                        Storyboard.TargetProperty="Angle"
                                                        From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- Preview tabs are added dynamically in code-behind -->
                </TabControl>
            </Border>
        </Grid>

        <!-- ═══════════════════ DRAG & DROP OVERLAY ═══════════════════ -->
        <Grid x:Name="DragOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <!-- dark semi-transparent backdrop -->
            <Border Background="#CC141418"/>
            <!-- accent frame + glow -->
            <Border BorderBrush="#FF4C7FDB"
                    BorderThickness="3"
                    CornerRadius="8"
                    Margin="24">
                <Border.Effect>
                    <DropShadowEffect Color="#FF4C7FDB" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                </Border.Effect>
            </Border>
            <!-- centered message -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Path Data="M20,6 L16,6 L16,0 L8,0 L8,6 L4,6 L12,14 Z M4,16 L4,18 L20,18 L20,16 Z"
                      Fill="#FF4C7FDB"
                      Width="52" Height="52"
                      Stretch="Uniform"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,20"
                      Opacity="0.95"/>
                <TextBlock Text="Drop your folders here"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center"
                           FontFamily="Segoe UI"/>
                <TextBlock Text="They will be added to your scan list"
                           FontSize="13"
                           Foreground="#FF8A8A8A"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"
                           FontFamily="Segoe UI"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════ STATUS BAR ═══════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusBarLabel"
                           Text="Ready"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

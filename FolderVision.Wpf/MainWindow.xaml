<Window x:Class="FolderVision.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="FolderVision"
        Icon="Ressources/app.ico"
        Width="1200" Height="760"
        MinWidth="900" MinHeight="600"
        Background="{StaticResource BackgroundDarkBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="52"/>
            <!-- Main content -->
            <RowDefinition Height="*"/>
            <!-- Status bar -->
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ TOP TOOLBAR (custom chrome) ═══════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <!-- App title — left side (draggable area via WindowChrome CaptionHeight) -->
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,120,0">
                    <Image Source="Ressources/foldervision_icon-removebg.png"
                           Height="50"
                           Width="50"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                    <TextBlock Text="FolderVision"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="  |  Multi-threaded folder scanner"
                               FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Window control buttons — right side -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch">
                    <!-- Minimize -->
                    <!-- Minimize -->
                    <Button Content="&#xE921;"
                            Width="46" Height="52"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource TitleBarButton}"
                            Click="MinimizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Minimize"/>
                    <!-- Maximize/Restore — rounded square drawn in XAML -->
                    <Button x:Name="MaximizeButton"
                            Width="46" Height="52"
                            Style="{StaticResource TitleBarButton}"
                            Click="MaximizeButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Maximize">
                        <Rectangle Width="10" Height="10"
                                   RadiusX="1" RadiusY="1"
                                   Fill="Transparent"
                                   StrokeThickness="1.5"
                                   Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <!-- Close -->
                    <Button Content="&#xE8BB;"
                            Width="46" Height="52"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="10"
                            Style="{StaticResource TitleBarCloseButton}"
                            Click="CloseButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════ MAIN CONTENT ═══════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left panel -->
                <ColumnDefinition Width="280" MinWidth="220"/>
                <!-- Splitter -->
                <ColumnDefinition Width="4"/>
                <!-- Center panel -->
                <ColumnDefinition Width="320" MinWidth="260"/>
                <!-- Splitter -->
                <ColumnDefinition Width="4"/>
                <!-- Right panel (tree) -->
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ──────────── LEFT PANEL ──────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,14,12,12">

                        <!-- Section: Paths -->
                        <TextBlock Text="SCAN PATHS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"

                                   Margin="0,0,0,8"/>

                        <!-- Path input row -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathInputBox"
                                     Grid.Column="0"
                                     Height="32"
                                     VerticalContentAlignment="Center"
                                     Tag="Folder path..."
                                     ToolTip="Enter a folder path to scan"/>
                            <Button Grid.Column="2"
                                    x:Name="BrowseButton"
                                    Content="Browse"
                                    Height="32"
                                    Style="{StaticResource DefaultButton}"
                                    Click="BrowseButton_Click"
                                    ToolTip="Browse for a folder"/>
                        </Grid>

                        <!-- Add path button -->
                        <Button x:Name="AddPathButton"
                                Content="+ Add Path"
                                Height="32"
                                Style="{StaticResource DefaultButton}"
                                Click="AddPathButton_Click"
                                Margin="0,0,0,8"
                                ToolTip="Add the entered path to the scan list"/>

                        <!-- Added paths list -->
                        <TextBlock Text="Added paths:"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,4"/>
                        <ListBox x:Name="PathsListBox"
                                 Height="120"
                                 Margin="0,0,0,6"
                                 ToolTip="Paths to scan. Select one and press Delete to remove."/>

                        <!-- Remove selected path -->
                        <Button x:Name="RemovePathButton"
                                Content="Remove Selected"
                                Height="28"
                                Style="{StaticResource DefaultButton}"
                                Click="RemovePathButton_Click"
                                Margin="0,0,0,16"
                                FontSize="11"
                                IsEnabled="False"/>

                        <!-- Separator -->
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                        <!-- Section: Settings -->
                        <TextBlock Text="SCAN SETTINGS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"

                                   Margin="0,0,0,10"/>

                        <!-- Threads slider -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Max Threads"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                            <TextBlock x:Name="ThreadCountLabel"
                                       Grid.Column="1"
                                       Text="8"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="ThreadsSlider"
                                Minimum="1"
                                Maximum="32"
                                Value="8"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0,0,0,12"
                                ValueChanged="ThreadsSlider_ValueChanged"
                                ToolTip="Number of parallel scan threads (1-32)"/>

                        <!-- Skip Hidden -->
                        <CheckBox x:Name="SkipHiddenCheckBox"
                                  Content="Skip Hidden Folders"
                                  IsChecked="True"
                                  Margin="0,0,0,8"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  ToolTip="Skip folders with the Hidden attribute"/>

                        <!-- Skip System -->
                        <CheckBox x:Name="SkipSystemCheckBox"
                                  Content="Skip System Folders"
                                  IsChecked="True"
                                  Margin="0,0,0,8"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="12"
                                  ToolTip="Skip folders with the System attribute"/>

                        <!-- ── Separator ────────────────────────────────── -->
                        <Separator Background="{StaticResource BorderBrush}"
                                   Margin="0,8,0,14"/>

                        <!-- Section: Export Settings -->
                        <TextBlock Text="EXPORT SETTINGS"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- Report Depth -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Report Depth"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       FontSize="12"/>
                            <TextBlock x:Name="ReportDepthLabel"
                                       Grid.Column="1"
                                       Text="2"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:Name="ReportDepthSlider"
                                Minimum="0" Maximum="10" Value="2"
                                TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Margin="0,0,0,4"
                                ValueChanged="ReportDepthSlider_ValueChanged"
                                ToolTip="Number of subfolder levels shown in the PDF report (0 = show all levels)"/>
                        <TextBlock Text="0 = show all levels"
                                   FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,0,0,8"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!-- ──────────── CENTER PANEL ──────────── -->
            <Border Grid.Column="2"
                    Background="{StaticResource BackgroundDarkBrush}">
                <!-- Single-layer Grid: all children share the full height.
                     Scan controls are always centered in the total panel height.
                     StatsBlock and Export buttons are pinned to the bottom. -->
                <Grid>

                    <!-- Scan controls: centered in the FULL panel height, never move -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="20">

                        <Button x:Name="StartScanButton"
                                Content="▶  Start Scan"
                                Style="{StaticResource BigScanButton}"
                                Click="StartScanButton_Click"
                                Margin="0,0,0,16"
                                IsEnabled="False"
                                ToolTip="Start scanning the added paths"/>

                        <Button x:Name="CancelScanButton"
                                Content="■  Cancel"
                                Style="{StaticResource DefaultButton}"
                                Click="CancelScanButton_Click"
                                Height="34"
                                IsEnabled="False"
                                Margin="0,0,0,24"
                                ToolTip="Cancel the running scan"/>

                        <ProgressBar x:Name="ScanProgressBar"
                                     Value="0"
                                     Maximum="100"
                                     Height="10"
                                     Width="260"
                                     Margin="0,0,0,8"/>

                        <TextBlock x:Name="ProgressLabel"
                                   Text="No scan running"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"/>
                    </StackPanel>

                    <!-- Bottom zone: StatsBlock above Export buttons, both pinned to bottom -->
                    <StackPanel VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Margin="20,0,20,16">

                        <!-- Stats block -->
                        <Border x:Name="StatsBlock"
                                Background="{StaticResource BackgroundMediumBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="16,12"
                                Margin="0,0,0,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="SCAN RESULTS"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="📁 Folders:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,4"/>
                                    <TextBlock x:Name="TotalFoldersLabel" Grid.Row="0" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="📄 Files:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,4"/>
                                    <TextBlock x:Name="TotalFilesLabel" Grid.Row="1" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="⏱ Duration:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="DurationLabel" Grid.Row="2" Grid.Column="1" Text="—" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Export buttons -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button x:Name="ExportHtmlButton"
                                    Content="📄 Export HTML"
                                    Style="{StaticResource DefaultButton}"
                                    Click="ExportHtmlButton_Click"
                                    IsEnabled="False"
                                    Margin="0,0,8,0"
                                    Height="34"
                                    ToolTip="Export scan results as an HTML report"/>
                            <Button x:Name="ExportPdfButton"
                                    Content="📑 Export PDF"
                                    Style="{StaticResource DefaultButton}"
                                    Click="ExportPdfButton_Click"
                                    IsEnabled="False"
                                    Height="34"
                                    ToolTip="Export scan results as a PDF report"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Cursor="SizeWE"/>

            <!-- ──────────── RIGHT PANEL (Tree) ──────────── -->
            <Border Grid.Column="4"
                    Background="{StaticResource BackgroundMediumBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Tree panel header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BackgroundLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,8">
                        <TextBlock Text="Folder Structure"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </Border>

                    <!-- Placeholder when no scan -->
                    <TextBlock x:Name="TreePlaceholder"
                               Grid.Row="1"
                               Text="Run a scan to view the folder structure here."
                               Foreground="{StaticResource TextMutedBrush}"
                               FontSize="13"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="240"
                               Margin="16"/>

                    <!-- Actual TreeView -->
                    <TreeView x:Name="FolderTreeView"
                              Grid.Row="1"
                              Margin="4"
                              Visibility="Collapsed"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════ STATUS BAR ═══════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BackgroundMediumBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <TextBlock x:Name="StatusBarLabel"
                           Text="Ready"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="FolderVision.Wpf.ExportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FolderVision.Wpf.Models"
        Title="Export Preview — FolderVision"
        Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Background="#FF1E1E1E"
        Foreground="#FFB0B0B0"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- CheckBox style matching dark theme -->
            <Style x:Key="PreviewCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="#FFB0B0B0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="Focusable" Value="False"/>
            </Style>

            <!-- Inline-editable TextBlock/TextBox -->
            <Style x:Key="NodeTextBlock" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style x:Key="NodeTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#FF2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="BorderBrush" Value="#FF4C7FDB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- TreeViewItem dark style -->
            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="#FFB0B0B0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="IsExpanded" Value="True"/>
                <Setter Property="Padding" Value="2,3"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#FF3C3C3F"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF2D2D30"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- TreeView dark style -->
            <Style TargetType="TreeView">
                <Setter Property="Background" Value="#FF252526"/>
                <Setter Property="BorderBrush" Value="#FF4A4A4D"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="4"/>
            </Style>

            <!-- HierarchicalDataTemplate for PreviewNode -->
            <HierarchicalDataTemplate x:Key="PreviewNodeTemplate"
                                      DataType="{x:Type local:PreviewNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <!-- Include checkbox -->
                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              Style="{StaticResource PreviewCheckBox}"/>

                    <!-- TextBlock (read mode) — hidden while editing -->
                    <TextBlock x:Name="NodeLabel"
                               Text="{Binding DisplayName}"
                               MouseLeftButtonDown="NodeLabel_MouseLeftButtonDown"
                               ToolTip="{Binding Source.FullPath}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource NodeTextBlock}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                        <Setter Property="Foreground" Value="#FF505050"/>
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- TextBox (edit mode) — collapsed by default -->
                    <TextBox x:Name="NodeEditor"
                             Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource NodeTextBox}"
                             Visibility="Collapsed"
                             LostFocus="NodeEditor_LostFocus"
                             KeyDown="NodeEditor_KeyDown"
                             MinWidth="180"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#FF252526" Padding="16,12" BorderBrush="#FF4A4A4D" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Export Preview"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#FFFFFFFF"/>
                <TextBlock x:Name="SubtitleLabel"
                           Text="Uncheck folders to exclude them from the PDF. Double-click a name to rename it."
                           FontSize="11"
                           Foreground="#FF707070"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tree -->
        <TreeView x:Name="PreviewTree"
                  Grid.Row="1"
                  Margin="12"
                  ItemTemplate="{StaticResource PreviewNodeTemplate}"
                  VirtualizingPanel.IsVirtualizing="False"/>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Background="#FF252526" Padding="16,10" BorderBrush="#FF4A4A4D" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="90" Height="32"
                        Margin="0,0,10,0"
                        Background="#FF3C3C3F"
                        Foreground="#FFB0B0B0"
                        BorderBrush="#FF4A4A4D"
                        Click="CancelButton_Click"/>
                <Button x:Name="ExportButton"
                        Content="Export PDF"
                        Width="110" Height="32"
                        Background="#FF4C7FDB"
                        Foreground="#FFFFFFFF"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="ExportButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

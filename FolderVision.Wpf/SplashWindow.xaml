<Window x:Class="FolderVision.Wpf.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderVision"
        Width="420" Height="240"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Icon + Title -->
        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="📁"
                       FontSize="44"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="FolderVision"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#FFFFFFFF"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Multi-threaded folder scanner"
                       FontSize="12"
                       Foreground="#FF707070"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Loading label -->
        <TextBlock x:Name="LoadingLabel"
                   Grid.Row="1"
                   Text="Starting..."
                   FontSize="11"
                   Foreground="#FF707070"
                   FontFamily="Segoe UI"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8"/>

        <!-- Animated loading bar (looping) -->
        <Grid Grid.Row="2" Margin="32,0,32,20" VerticalAlignment="Bottom">
            <Border Background="#FF2D2D30" CornerRadius="3" Height="4"/>
            <Canvas Height="4" ClipToBounds="True">
                <Border x:Name="LoadingBar"
                        Background="#FF4C7FDB"
                        CornerRadius="3"
                        Height="4"
                        Width="80"
                        Canvas.Left="-80">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard x:Name="LoadingBarStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetName="LoadingBar"
                                        Storyboard.TargetProperty="(Canvas.Left)"
                                        From="-80" To="356"
                                        Duration="0:0:1.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Unloaded">
                            <StopStoryboard BeginStoryboardName="LoadingBarStoryboard"/>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</Window>

<Window x:Class="FolderVision.Wpf.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FolderVision"
        Width="420" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False">

    <Border Background="#FF1E1E1E"
            CornerRadius="12"
            BorderBrush="#FF4A4A4D"
            BorderThickness="1">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <!-- Icon + Title -->
            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="📁"
                           FontSize="48"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>
                <TextBlock Text="FolderVision"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#FFFFFFFF"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Multi-threaded folder scanner"
                           FontSize="12"
                           Foreground="#FF707070"
                           FontFamily="Segoe UI"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Loading label -->
            <TextBlock Grid.Row="1"
                       x:Name="LoadingLabel"
                       Text="Loading..."
                       FontSize="11"
                       Foreground="#FF707070"
                       FontFamily="Segoe UI"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Animated loading bar -->
            <Grid Grid.Row="2" Margin="32,0,32,24" VerticalAlignment="Bottom">
                <Border Background="#FF2D2D30"
                        CornerRadius="4"
                        Height="4"/>
                <Border x:Name="LoadingBar"
                        Background="#FF4C7FDB"
                        CornerRadius="4"
                        Height="4"
                        HorizontalAlignment="Left"
                        Width="0"
                        RenderTransformOrigin="0,0.5">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetProperty="Width"
                                        Duration="0:0:1.4">
                                        <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                        <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="356">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                        <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="0">
                                            <EasingDoubleKeyFrame.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </EasingDoubleKeyFrame.EasingFunction>
                                        </EasingDoubleKeyFrame>
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

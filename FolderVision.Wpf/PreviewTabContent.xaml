<UserControl x:Class="FolderVision.Wpf.PreviewTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderVision.Wpf.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Node label -->
            <Style x:Key="PreviewNodeLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                        <Setter Property="Foreground" Value="#FF505050"/>
                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Node inline editor -->
            <Style x:Key="PreviewNodeEditor" TargetType="TextBox">
                <Setter Property="Background" Value="#FF2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="BorderBrush" Value="#FF4C7FDB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="MinWidth" Value="160"/>
            </Style>

            <!-- TreeViewItem: bind IsExpanded to PreviewNode.IsExpanded -->
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            </Style>

            <!-- HierarchicalDataTemplate -->
            <HierarchicalDataTemplate DataType="{x:Type local:PreviewNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              Style="{StaticResource DarkCheckBox}"
                              Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding DisplayName}"
                               Style="{StaticResource PreviewNodeLabel}"
                               MouseLeftButtonDown="NodeLabel_MouseLeftButtonDown"
                               ToolTip="{Binding Source.FullPath}"/>
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PreviewNodeEditor}"
                             LostFocus="NodeEditor_LostFocus"
                             KeyDown="NodeEditor_KeyDown"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header options bar -->
        <Border Grid.Row="0"
                Background="#FF2D2D30"
                BorderBrush="#FF4A4A4D"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="IncludeHeaderCheckBox"
                          Style="{StaticResource DarkCheckBox}"
                          IsChecked="True"
                          Margin="0,0,8,0"/>
                <TextBlock Text="Include header in PDF"
                           FontSize="12"
                           Foreground="#FFB0B0B0"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"/>
            </StackPanel>
        </Border>

        <!-- Preview tree -->
        <TreeView x:Name="PreviewTree"
                  Grid.Row="1"
                  Background="#FF252526"
                  BorderThickness="0"
                  Margin="4"/>
    </Grid>
</UserControl>

<UserControl x:Class="FolderVision.Wpf.PreviewTabContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FolderVision.Wpf.Models">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Node label style -->
            <Style x:Key="PreviewNodeLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                        <Setter Property="Foreground" Value="#FF505050"/>
                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Node editor style -->
            <Style x:Key="PreviewNodeEditor" TargetType="TextBox">
                <Setter Property="Background" Value="#FF2D2D30"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="BorderBrush" Value="#FF4C7FDB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="3,1"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Setter Property="MinWidth" Value="160"/>
            </Style>

            <!-- HierarchicalDataTemplate for PreviewNode -->
            <HierarchicalDataTemplate DataType="{x:Type local:PreviewNode}"
                                      ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"
                              Focusable="False"/>
                    <TextBlock Text="{Binding DisplayName}"
                               Style="{StaticResource PreviewNodeLabel}"
                               MouseLeftButtonDown="NodeLabel_MouseLeftButtonDown"
                               ToolTip="{Binding Source.FullPath}"/>
                    <TextBox Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource PreviewNodeEditor}"
                             LostFocus="NodeEditor_LostFocus"
                             KeyDown="NodeEditor_KeyDown"/>
                </StackPanel>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <TreeView x:Name="PreviewTree"
              Background="#FF252526"
              BorderThickness="0"
              Margin="4"/>
</UserControl>
